/* Hoja de estilos de A3I. Los @nombre se cambian por los colores de PALETA */

/* Base */

QWidget {
    font-family: "Roboto";
    font-size: 14px;
    color: @grafito;
}

QMainWindow, QDialog {
    background-color: @fondo;
}

/* Cabecera, menú y panel del login */
*[zona="oscura"] {
    background-color: @azul_marino;
}

*[zona="oscura"] QLabel {
    color: @fondo;
}

/* Textos */

QLabel[tipo="titulo"] {
    font-family: "Inter";
    font-weight: 700;
    font-size: 28px;
    color: @azul_marino;
}

*[zona="oscura"] QLabel[tipo="titulo"] {
    color: @fondo;
}

QLabel[tipo="subtitulo"] {
    color: @pizarra;
}

*[zona="oscura"] QLabel[tipo="subtitulo"],
*[zona="oscura"] QLabel[tipo="seccion"] {
    color: @borde;
}

QLabel[tipo="etiqueta"] {
    font-family: "Inter";
    font-weight: 600;
    font-size: 13px;
    color: @azul_marino;
}

QLabel[tipo="seccion"] {
    font-family: "Inter";
    font-weight: 600;
    font-size: 11px;
    color: @pizarra;
}

/* Datos numéricos */
QLabel[tipo="dato"] {
    font-family: "Cascadia Code";
}

QLabel[tipo="error"] {
    background-color: @rojo_suave;
    color: @rojo_texto;
    border-radius: 6px;
    padding: 10px 12px;
}

/* Tarjetas */

QFrame[tipo="tarjeta"] {
    background-color: @blanco;
    border: 1px solid @borde;
    border-radius: 12px;
}

/* Campos de formulario */

QLineEdit, QComboBox {
    background-color: @blanco;
    border: 1px solid @borde;
    border-radius: 6px;
    padding: 8px 10px;
    selection-background-color: @turquesa;
    selection-color: @azul_marino;
}

QLineEdit:focus, QComboBox:focus {
    border: 1px solid @turquesa;
}

/* Botones */

QPushButton {
    font-family: "Inter";
    font-weight: 600;
    font-size: 14px;
    border-radius: 6px;
    padding: 10px 18px;
}

/* Texto oscuro porque el blanco sobre turquesa casi no se lee */
QPushButton[tipo="primario"] {
    background-color: @turquesa;
    color: @azul_marino;
    border: none;
}

QPushButton[tipo="primario"]:hover {
    background-color: @turquesa_hover;
}

QPushButton[tipo="secundario"] {
    background-color: @blanco;
    color: @azul_marino;
    border: 1px solid @borde;
}

QPushButton[tipo="secundario"]:hover {
    background-color: @fondo;
}

QPushButton[tipo="peligro"] {
    background-color: @rojo;
    color: @blanco;
    border: none;
}

QPushButton[tipo="peligro"]:hover {
    background-color: @rojo_hover;
}

QPushButton:disabled,
QPushButton[tipo="primario"]:disabled,
QPushButton[tipo="secundario"]:disabled,
QPushButton[tipo="peligro"]:disabled {
    background-color: @deshabilitado;
    color: @pizarra;
    border: none;
}

/* Menú lateral */

QPushButton[tipo="menu"] {
    font-family: "Roboto";
    font-weight: 500;
    background-color: transparent;
    color: @borde;
    border: none;
    border-radius: 8px;
    padding: 10px 14px;
    text-align: left;
}

QPushButton[tipo="menu"]:hover {
    background-color: @pizarra;
    color: @fondo;
}

QPushButton[tipo="menu"]:checked {
    background-color: @turquesa;
    color: @azul_marino;
    font-weight: 600;
}

/* Etiquetas de estado */

QLabel[estado] {
    font-family: "Inter";
    font-weight: 600;
    font-size: 12px;
    border-radius: 10px;
    padding: 3px 10px;
}

QLabel[estado="ok"] {
    background-color: @verde_suave;
    color: @verde_texto;
}

QLabel[estado="aviso"] {
    background-color: @ambar_suave;
    color: @ambar_texto;
}

QLabel[estado="alarma"] {
    background-color: @rojo_suave;
    color: @rojo_texto;
}

/* Mantenimiento, sin conexión... */
QLabel[estado="neutro"] {
    background-color: @neutro_suave;
    color: @pizarra;
}

/* Login */

*[zona="oscura"] QLabel[tipo="etiqueta"] {
    color: @fondo;
    font-size: 20px;
}

*[zona="oscura"] QLabel[tipo="dato"] {
    color: @borde;
    font-size: 12px;
}

QFrame[tipo="acento"] {
    background-color: @turquesa;
    border-radius: 2px;
}

*[zona="oscura"] QLabel[tipo="chip"] {
    color: @borde;
    border: 1px solid @pizarra;
    border-radius: 12px;
    padding: 4px 12px;
    font-size: 13px;
}

QFrame[tipo="separador"] {
    background-color: @borde;
}

QLabel[tipo="nota"] {
    color: @pizarra;
    font-size: 13px;
}
